# Copy to .env and adjust values for your environment.
APP_NAME=AI Career Mentor & Skill Gap Analyzer
ENVIRONMENT=development

# MySQL connection (SQLAlchemy + PyMySQL)
# The application configures utf8mb4 for MySQL connections.
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_career_mentor

# JWT (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JSON list of exact frontend origins; [] disables cross-origin access.
CORS_ALLOWED_ORIGINS=[]

# Google Gemini cho lớp AI dùng chung.
# Lấy API Key tại https://aistudio.google.com/apikey và chỉ lưu trong .env.
# Tuyệt đối không commit API Key hoặc gửi xuống frontend.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT=30
AI_MAX_RETRIES=2
